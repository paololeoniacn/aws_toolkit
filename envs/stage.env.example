# Credenziali AWS — ambiente STAGE legacy (cluster: eks-tibco-stage-cluster)
# Recuperare dal portale AWS SSO
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=eu-south-1

# Log group singolo (modalità diretta, senza discovery)
LOG_GROUP=/aws/eks/eks-tibco-stage-cluster
