# Credenziali AWS — ambiente PROD PSN (cluster: tdh-prod-apilayer)
# Recuperare dal portale AWS SSO (scadono ogni ~1h)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=eu-south-1

# Discovery log group per prefisso (modalità multi-gruppo)
LOG_GROUP_PREFIX=/aws/eks/tdh-

# Prefisso stream FluentBit — non modificare salvo setup non standard
EKS_STREAM_PREFIX=fluentbit-kube.var.log.containers.
